package com.arin.civicreport.ui.screens

import android.content.Context
import android.content.Intent
import android.net.Uri
import androidx.compose.foundation.border
import androidx.compose.foundation.clickable
import androidx.compose.foundation.layout.*
import androidx.compose.foundation.shape.RoundedCornerShape
import androidx.compose.material.icons.Icons
import androidx.compose.material.icons.filled.LocationOn
import androidx.compose.material3.*
import androidx.compose.runtime.*
import androidx.compose.ui.Alignment
import androidx.compose.ui.Modifier
import androidx.compose.ui.platform.LocalContext
import androidx.compose.ui.text.font.FontWeight
import androidx.compose.ui.unit.dp
import com.arin.civicreport.ui.location.CurrentLocation
import com.arin.civicreport.ui.location.LocationManager
import com.arin.civicreport.ui.util.NetworkChecker

@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun LocationDetailsScreen(
    incidentTypes: List<String>,
    mediaUri: String?,
    mediaType: String,
    latitude: Double,
    longitude: Double,
    address: String,
    onLocationConfirmed: (Double, Double, String) -> Unit,
    onRetake: () -> Unit
) {
    val context = LocalContext.current
    val locationManager = remember { LocationManager(context) }
    var lat by remember { mutableStateOf(latitude) }
    var lon by remember { mutableStateOf(longitude) }
    var addr by remember { mutableStateOf(address) }
    var description by remember { mutableStateOf("") }
    var currentState by remember { mutableStateOf<LocationManager.LocationState?>(null) }

    LaunchedEffect(Unit) {
        locationManager.observeState().collect { state ->
            currentState = state
            when (state) {
                is LocationManager.LocationState.Ready -> {
                    lat = state.loc.latitude
                    lon = state.loc.longitude
                    addr = state.loc.address
                }
                is LocationManager.LocationState.Error -> {
                    // User can still confirm with manual coords
                }
                else -> {}
            }
        }
    }

    fun saveStateToNextScreen(ctx: Context) {
        val intent = Intent(ctx, MainActivity::class.java).apply {
            putExtra("lat", lat)
            putExtra("lon", lon)
            putExtra("address", addr)
            putExtra("description", description)
            addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_CLEAR_TASK)
        }
        // Note: This is a workaround since NavHost won't carry data through MainActivity.
        // The actual navigation below does NOT go through MainActivity, so we just rely on the
        // savedStateHandle approach in the nav graph. If that fails, the user edits manually.
    }

    Scaffold(topBar = {
        TopAppBar(title = { Text("Location &amp; Details", fontWeight = FontWeight.Bold) })
    }, floatingActionButton = {
        FloatingActionButton(onClick = {
            onLocationConfirmed(lat, lon, addr)
        }) {
            Icon(Icons.Default.Check, contentDescription = "Confirm location")
        }
    }) { padding ->
        Column(modifier = Modifier
            .fillMaxSize()
            .padding(padding)
            .padding(16.dp)) {
            Card(
                modifier = Modifier
                    .aspectRatio(1f)
                    .clickable {
                        lat = 19.0760 + (Math.random() * 0.1 - 0.05)
                        lon = 72.8777 + (Math.random() * 0.1 - 0.05)
                        addr = "Manually placed pin at ${"%.6f".format(lat)}, ${"%.6f".format(lon)}"
                        description = ""
                    }
                    .border(1.dp, MaterialTheme.colorScheme.outline, RoundedCornerShape(12.dp)),
                colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surfaceVariant)
            ) {
                Box(contentAlignment = Alignment.Center) {
                    when {
                        currentState is LocationManager.LocationState.Loading -> {
                            CircularProgressIndicator()
                        }
                        currentState is LocationManager.LocationState.Error -> {
                            Column(horizontalAlignment = Alignment.CenterHorizontally) {
                                Icon(Icons.Default.LocationOn, contentDescription = null, tint = MaterialTheme.colorScheme.error)
                                Text(
                                    "Location could not be auto-detected. Tap the map to place a pin manually.",
                                    style = MaterialTheme.typography.bodyMedium,
                                    modifier = Modifier.padding(16.dp)
                                )
                            }
                        }
                        else -> {
                            Column(horizontalAlignment = Alignment.CenterHorizontally) {
                                Icon(Icons.Default.LocationOn, contentDescription = null, tint = MaterialTheme.colorScheme.primary)
                                Text(
                                    "Tap the map to adjust the pin",
                                    style = MaterialTheme.typography.bodyMedium
                                )
                                Text(
                                    "Lat: ${"%.6f".format(lat)}  Lon: ${"%.6f".format(lon)}",
                                    style = MaterialTheme.typography.bodySmall
                                )
                            }
                        }
                    }
                }
            }
            Spacer(modifier = Modifier.height(12.dp))
            Card(modifier = Modifier.fillMaxWidth(), colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surfaceVariant)) {
                Column(modifier = Modifier.padding(12.dp)) {
                    Text("Detected address: ${addr.ifBlank { "unknown" }}", style = MaterialTheme.typography.bodyLarge)
                    Text("Lat: ${"%.6f".format(lat)}", style = MaterialTheme.typography.bodySmall)
                    Text("Lon: ${"%.6f".format(lon)}", style = MaterialTheme.typography.bodySmall)
                    OutlinedTextField(
                        value = description,
                        onValueChange = { description = it },
                        modifier = Modifier.fillMaxWidth(),
                        placeholder = { Text("Add description or notes...") }
                    )
                }
            }
            Spacer(modifier = Modifier.height(8.dp))
            if (!NetworkChecker.isOnline(context = context)) {
                Text(
                    "No internet — you will need network access to send the report to authorities.",
                    style = MaterialTheme.typography.bodySmall,
                    color = MaterialTheme.colorScheme.onSurfaceVariant
                )
            }
        }
    }
}
